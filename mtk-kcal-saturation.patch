+#define SAT_MIN		0
+#define SAT_MAX		1536	/* 1.5x; HW coef range is +-2.0 */
+
+/* user color state, 1024 == 1.0 */
+static int g_user_gain[3] = { 1024, 1024, 1024 };
+static int g_user_sat = 1024;
 
