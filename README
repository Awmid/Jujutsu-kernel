 static atomic_t needs_reclaim = ATOMIC_INIT(0);

 static int victim_size_cmp(const void *lhs_ptr, const void *rhs_ptr)
@@ -206,7 +206,7 @@ static void scan_and_kill(unsigned long pages_needed)
